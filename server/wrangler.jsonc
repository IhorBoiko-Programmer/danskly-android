{
  // Налаштування Cloudflare Worker для Danskly.
  "name": "danskly",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Звичайні (не секретні) налаштування. Ключі сюди НЕ пиши — тільки через секрети.
  "vars": {
    "AI_MODELS": "deepseek-v4.1-flash,deepseek-v4-pro,glm-5.1",
    "AI_BASE_URL": "https://opencode.ai/inference/go/v1",
    "AI_TIMEOUT_MS": "20000",
    "RATE_LIMIT": "60"
  }
}
