<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Danskly" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Danskly.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/danish_red</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Danskly</item>
    </style>
</resources>
